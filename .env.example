# democraft-mcp env example (copy to .env - never commit .env)
DEMOCRAFT_PORT=11246
DEMOCRAFT_MODEL=gemma4:e4b
DEMOCRAFT_OLLAMA_URL=http://127.0.0.1:11434
DEMOCRAFT_OUTBOX=./outbox
DEMOCRAFT_PREFAB_APPS=1
DEMOCRAFT_PROGRAM_FILES=C:\Program Files
# Override the FreeCAD console binary (default is a fixed install path; when the file
# does not exist the CAD demo reports wrappee_missing with recovery text - by design).
# DEMOCRAFT_FREECADCMD=C:\Program Files\FreeCAD 1.1\bin\freecadcmd.exe
